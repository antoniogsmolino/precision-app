# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/radar_finanza_agevolata"

# --- Autenticazione (NextAuth) ------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# genera con: openssl rand -base64 32
NEXTAUTH_SECRET="cambiami-con-un-valore-random"

# --- Email transazionale (Resend) ---------------------------------------
# https://resend.com — piano free sufficiente per il volume iniziale.
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="MOLO 4.0 <radar@molo4punto0.it>"
MOLO_PHONE_NUMBER="+39 0000000000"
MOLO_BOOKING_URL="https://calendly.com/molo4punto0/consulenza"

# --- Motore di monitoraggio fonti ----------------------------------------
# token semplice per proteggere l'endpoint di scan schedulato (es. Vercel Cron)
CRON_SECRET="cambiami-con-un-valore-random"
# User-Agent onesto usato dagli scraper verso i siti delle fonti pubbliche
SCAN_USER_AGENT="MOLO4.0-RadarFinanzaAgevolata/1.0 (+https://molo4punto0.it/bot)"

# --- Filtro AI di rilevanza sui candidati estratti dai parser (facoltativo,
# fail-open se assente: vedi src/lib/monitoring/classificatore.ts) --------
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxx"

# --- OpenAPI Company (IT-search + IT-advanced) ---------------------------
# Usata da DUE flussi che condividono la stessa cache/budget:
#  1. Frontend pubblico Finanza Agevolata Match (Fase 3) — una P.IVA nota,
#     risolta via IT-advanced (src/lib/integrations/openapi-business.ts).
#  2. Motore di prospecting automatico per bando (src/lib/prospecting/) —
#     cerca aziende compatibili via IT-search, arricchisce solo le
#     candidate selezionate via IT-advanced. Sostituisce il CSV manuale.
# Senza questa chiave, entrambi i flussi rispondono con un errore esplicito
# ("servizio non configurato"), non inventano dati.
OPENAPI_IT_API_KEY="cambiami-con-la-tua-api-key"
# Di default punta a company.openapi.com (endpoint confermato dalle
# specifiche del team) — sovrascrivi solo se il vostro account usa un
# dominio diverso.
# OPENAPI_IT_BASE_URL="https://company.openapi.com"

# Prezzi di riferimento per il calcolo del costo stimato (§12 delle
# specifiche) — la tariffa REALE del vostro piano va verificata sui
# consumi effettivi dell'account, questi sono solo i default per le
# simulazioni indicati dal team.
# OPENAPI_PREZZO_SEARCH_EUR="0.01"
# OPENAPI_PREZZO_ADVANCED_EUR="0.028"

# Guardrail di spesa (§12) — un run di ricerca aziende non spende mai oltre
# questi limiti, sospendendosi (non fallendo) se il budget non basta.
# OPENAPI_BUDGET_GIORNALIERO_EUR="5"
# OPENAPI_BUDGET_MENSILE_EUR="50"

# Limiti per singolo run di ricerca (§13, "lotto commerciale iniziale: 100
# candidate") — quante aziende candidare/arricchire al massimo per ogni
# click su "Avvia ricerca".
# OPENAPI_MAX_CANDIDATE_PER_RUN="100"
# OPENAPI_MAX_ADVANCED_PER_RUN="50"

# Per quanti giorni riutilizzare un'anagrafica già acquisita via Advanced
# prima di richiamarlo di nuovo per la stessa azienda (§8, default proposto
# dal team: 90, anche 180 accettabile).
# OPENAPI_ADVANCED_TTL_GIORNI="90"
