// Radar Finanza Agevolata — MOLO 4.0
// Schema dati Fase 1. Vedi docs/radar-finanza-agevolata.md per le note di progetto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Autenticazione team MOLO (accesso unico, nessuna gerarchia di ruoli in v1)
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Fonti monitorate — tabella estensibile: una nuova fonte = una nuova riga +
// un nuovo parser registrato in src/lib/monitoring/parsers/registry.ts.
// ---------------------------------------------------------------------------
enum LivelloFonte {
  L1_NAZIONALE
  L2_REGIONALE
  L3_CAMERALE
}

enum EsitoScan {
  SUCCESSO
  ERRORE
  BLOCCATO_ROBOTS
}

// Livello di affidabilità della fonte (specifica motore bandi, §4): il
// catalogo ufficiale nazionale è Tier 0, i registri di riconciliazione
// (RNA/OpenCoesione/SIAN) Tier 1, le fonti istituzionali dirette (siti di
// enti/Regioni/Comuni) Tier 2. Guida la priorità nei conflitti fra fonti,
// non sostituisce `livello` (che invece descrive l'ambito: nazionale/
// regionale/camerale).
enum SourceTier {
  TIER_0_CATALOGO_NAZIONALE
  TIER_1_RICONCILIAZIONE
  TIER_2_FONTE_DIRETTA
}

// Tipo tecnico della fonte (specifica, §11) — determina quale adapter in
// src/lib/motore-bandi/adapters/ la legge. Sottoinsieme pragmatico
// dell'elenco della specifica: si estende quando serve un nuovo adapter,
// non prima.
enum SourceType {
  OPEN_DATA_JSON
  OPEN_DATA_CSV
  REST_API
  RSS
  SITEMAP
  HTML_LIST
  HTML_SEARCH
  JS_RENDERED
  PDF_ARCHIVE
  BUR
  ALTRO
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  FAILING
  BLOCKED
  UNKNOWN
  DISABLED
}

model Fonte {
  id                  String       @id @default(cuid())
  nome                String
  livello             LivelloFonte
  regione             String? // valorizzato per fonti regionali/camerali
  url                 String
  /// Chiave del parser dedicato in src/lib/monitoring/parsers/registry.ts
  /// — motore "Livello 1" esistente (selettori HTML calibrati per fonte).
  /// Resta finché quel motore è in uso; le fonti migrate al nuovo motore
  /// bandi (Source Registry) valorizzano invece sourceType/adapterKey.
  parserKey           String       @unique
  attiva              Boolean      @default(true)
  frequenzaOreScan    Int          @default(24)
  ultimaScansioneAt   DateTime?
  ultimoEsitoScan     EsitoScan?
  ultimoHashContenuto String?
  note                String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // --- Source Registry (specifica motore bandi, §11) ---------------------
  // Tutti opzionali: una Fonte esistente del vecchio motore non ha ancora
  // questi valori finché non viene migrata a un adapter del nuovo motore.
  sourceTier          SourceTier?
  sourceType          SourceType?
  /// Chiave dell'adapter in src/lib/motore-bandi/adapters/registry.ts —
  /// distinta da parserKey: un domani una stessa Fonte può passare dal
  /// vecchio parser al nuovo adapter senza perdere lo storico scan.
  adapterKey          String?
  healthStatus        HealthStatus @default(UNKNOWN)
  consecutiveFailures Int          @default(0)
  ultimoCambiamentoAt DateTime? // last_change_at: ultima volta che il contenuto è cambiato davvero

  misure       Misura[]
  scanLogs     ScanLog[]
  rawSnapshots RawSnapshot[]
}

model ScanLog {
  id               String    @id @default(cuid())
  fonteId          String
  fonte            Fonte     @relation(fields: [fonteId], references: [id], onDelete: Cascade)
  avviatoAt        DateTime  @default(now())
  completatoAt     DateTime?
  esito            EsitoScan
  misureNuove      Int       @default(0)
  misureAggiornate Int       @default(0)
  messaggioErrore  String?

  @@index([fonteId, avviatoAt])
}

// ---------------------------------------------------------------------------
// Misure di finanza agevolata
// ---------------------------------------------------------------------------
enum CategoriaMisura {
  NAZIONALE
  REGIONALE
  CAMERALE
  FISCALE
}

enum TipoAgevolazione {
  FONDO_PERDUTO
  TASSO_ZERO
  CREDITO_IMPOSTA
  MISTO
}

enum TipoValoreMisura {
  IMPORTO_FISSO
  RANGE
  PERCENTUALE
}

enum StatoPratica {
  CANDIDATA
  AMMESSA
  RESPINTA
  CONTRATTO_ATTIVO
}

// Stato dichiarato esplicitamente dalla fonte ufficiale (specifica motore
// bandi, §21.3/§34) — NON sostituisce lo stato mostrato in dashboard
// (Futura/Attiva/In scadenza/Scaduta), che resta sempre ricalcolato a
// runtime da src/lib/misure/stato.ts a partire dalle date. Serve per i
// casi che le sole date non possono rappresentare: una sospensione, un
// esaurimento fondi o un annullamento dichiarati sulla fonte, che le date
// da sole farebbero sembrare ancora "Attiva". Se presente, la UI deve
// darle priorità sullo stato calcolato dalle date.
enum StatoDichiaratoBando {
  PRENOTICE
  UPCOMING
  OPEN
  PAUSED
  FUNDS_EXHAUSTED
  CLOSED
  CANCELLED
  REOPENED
}

// Regole di pubblicazione (specifica motore bandi, §52): un record del
// nuovo motore non entra "confermato" solo perché è stato letto da una
// fonte — la confidence sui campi critici decide se può dirsi verificato
// o se va segnalato per revisione. DEFAULT PUBBLICATA: le misure inserite
// a mano dal team e quelle del vecchio motore (che non calcola confidence
// per campo) restano visibili esattamente come oggi — questo stato è
// significativo solo per le misure scritte dal nuovo motore bandi.
enum StatoPubblicazioneMisura {
  DRAFT
  AUTO_VERIFICATA
  DA_VERIFICARE
  PUBBLICATA
  ARCHIVIATA
}

model Misura {
  id                String          @id @default(cuid())
  titolo            String
  ente              String
  categoria         CategoriaMisura
  descrizioneBreve  String
  descrizioneEstesa String

  // --- Livello "programma" del modello Misura/Bando/Finestra (specifica
  // motore bandi, §3) — questa riga Misura corrisponde al livello "Bando/
  // procedura attuativa" della specifica (è l'unità mostrata in dashboard
  // e usata per il matching, non tocco quella parte già funzionante).
  // programmaId collega più edizioni/rifinanziamenti dello stesso quadro
  // giuridico nel tempo, quando riconosciuti come tali — opzionale, nullo
  // finché non riconciliato.
  programmaId String?
  programma   Programma? @relation(fields: [programmaId], references: [id], onDelete: SetNull)

  // Identificativi esterni ufficiali (specifica, §21.2) — chiave primaria
  // per la deduplicazione "hard identifier" (§30.1). @unique su un campo
  // nullable in Postgres consente comunque più righe NULL: non forza unicità
  // finché il valore non è noto.
  incentiviGovId String? @unique
  rnaCar         String?
  sianCar        String?

  // Stato dichiarato dalla fonte, quando esplicito — vedi commento
  // sull'enum. Nullo per le misure inserite manualmente o rilevate dal
  // vecchio motore, che non lo popolano.
  statoDichiarato StatoDichiaratoBando?

  // Vedi commento sull'enum StatoPubblicazioneMisura sopra.
  statoPubblicazione StatoPubblicazioneMisura @default(PUBBLICATA)

  tipoAgevolazione TipoAgevolazione
  tipoValore       TipoValoreMisura
  importoFisso     Decimal?         @db.Decimal(14, 2)
  importoMin       Decimal?         @db.Decimal(14, 2)
  importoMax       Decimal?         @db.Decimal(14, 2)
  percentuale      Decimal?         @db.Decimal(5, 2)
  tettoMassimo     Decimal?         @db.Decimal(14, 2)

  dataApertura    DateTime
  dataScadenza    DateTime
  /// true quando dataScadenza è un fallback del parser (nessuna data letta
  /// dalla pagina), non una scadenza confermata sulla fonte — mostrato in UI
  /// come "data da verificare" ed escluso dagli alert di scadenza imminente.
  scadenzaStimata Boolean  @default(false)

  // Requisiti di ammissibilità — lo stato (Futura/Attiva/In scadenza/Scaduta)
  // NON è persistito: viene sempre ricalcolato da src/lib/misure/stato.ts
  // a partire da dataApertura/dataScadenza.
  atecoAmmessi   String[] @default([])
  atecoEsclusi   String[] @default([])
  regioniAmmesse String[] @default([]) // [] = tutte le regioni
  fatturatoMin   Decimal? @db.Decimal(14, 2)
  fatturatoMax   Decimal? @db.Decimal(14, 2)
  dipendentiMin  Int?
  dipendentiMax  Int?
  altriRequisiti String?

  documentiRichiesti String[] @default([])
  linkFonteUfficiale String
  noteInterne        String?

  // Provenienza
  rilevataAutomaticamente Boolean @default(false)
  fonteId                 String?
  fonte                   Fonte?  @relation(fields: [fonteId], references: [id], onDelete: SetNull)
  /// Identificatore stabile assegnato dal parser (es. hash dell'URL di dettaglio)
  /// usato per capire se una scansione ha già visto questa misura.
  externalId              String?

  // --- No-delete policy (specifica motore bandi, §37/§101 punto 4: "mai
  // cancellare un bando perché sparisce da una lista") — solo per le
  // misure del nuovo motore bandi (rilevataAutomaticamente + fonteId).
  // Quando un bando non compare più nel feed, NON si cancella né si
  // chiude in automatico: si incrementa assenzeConsecutive e si segnala
  // nel backoffice per una conferma umana — la sparizione potrebbe
  // dipendere da un errore della fonte, non dalla vera chiusura del
  // bando (§37 elenca proprio questo: manutenzione, filtro, paginazione).
  ultimoVistoInFonteAt DateTime?
  assenzeConsecutive   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cumulabilità: relazione simmetrica misura<->misura, sempre scritta e letta
  // in entrambe le direzioni da src/lib/misure/cumulabilita.ts
  cumulabiliComeA Misura[] @relation("Cumulabilita")
  cumulabiliComeB Misura[] @relation("Cumulabilita")

  matches ProspectMisuraMatch[]

  ricercheProspect RicercaProspectLog[]
  usoApiOpenApi    ApiUsageLog[]

  // --- Motore bandi: livello "finestra" + documenti + evidence + eventi ---
  finestre  FinestraTemporale[]
  documenti DocumentoUfficiale[]
  evidenze  Evidence[]
  eventi    EventoBando[]

  @@unique([fonteId, externalId])
  @@index([categoria])
  @@index([dataScadenza])
  @@index([dataApertura])
}

// ---------------------------------------------------------------------------
// Motore bandi — modello Misura/Bando/Finestra, documenti, evidence, eventi
// (specifica tecnica motore nazionale bandi finanza agevolata, §3/§16/§19/
// §21/§26/§33). Il "Bando" della specifica resta il model `Misura` sopra
// (già l'unità mostrata in dashboard e usata dal matching); qui i due
// livelli mancanti — Programma e Finestra — più il grafo documentale,
// l'evidence per campo e il log eventi append-only.
// ---------------------------------------------------------------------------

// Livello "Misura" della specifica (§3.1): il quadro giuridico/programma
// che può durare anni e avere più edizioni/rifinanziamenti. Volutamente
// minimale: si arricchisce quando la riconciliazione fra fonti lo richiede
// davvero, non prima.
model Programma {
  id            String   @id @default(cuid())
  titolo        String
  ente          String
  baseGiuridica String?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  misure Misura[]
}

enum TipoChiusuraFinestra {
  DATA_FISSA
  ESAURIMENTO_FONDI
  FINO_A_REVOCA
  FINESTRE_MULTIPLE
  CLICK_DAY
  SCONOSCIUTO
}

// Livello "Finestra" della specifica (§3.3/§21.4): un bando può avere più
// finestre (prima apertura, riapertura, proroga...). dataApertura/
// dataScadenza su Misura restano come "finestra corrente" denormalizzata
// per compatibilità con la UI/matching esistenti — questa tabella è la
// fonte di verità quando servono tutte le finestre, non solo l'ultima.
model FinestraTemporale {
  id           String               @id @default(cuid())
  misuraId     String
  misura       Misura               @relation(fields: [misuraId], references: [id], onDelete: Cascade)
  etichetta    String?
  apreIl       DateTime?
  chiudeIl     DateTime?
  tipoChiusura TipoChiusuraFinestra @default(SCONOSCIUTO)
  note         String?
  /// true sulla finestra attualmente rilevante — al più una per misura.
  corrente     Boolean              @default(false)
  createdAt    DateTime             @default(now())

  @@index([misuraId])
}

enum RuoloDocumento {
  BANDO
  DECRETO_ATTUATIVO
  RETTIFICA
  PROROGA
  ALLEGATO
  FAQ
  MODULISTICA
  GRADUATORIA
  PORTALE_DOMANDA
  ALTRO
}

// Documento ufficiale collegato a una misura (specifica, §16 "Document
// Graph"). Il contenuto vero e proprio vive in DocumentoVersione — un
// documento può cambiare più volte (proroghe, rettifiche) senza perdere lo
// storico.
model DocumentoUfficiale {
  id          String         @id @default(cuid())
  misuraId    String?
  misura      Misura?        @relation(fields: [misuraId], references: [id], onDelete: SetNull)
  urlCanonico String
  ruolo       RuoloDocumento
  mimeType    String?
  createdAt   DateTime       @default(now())

  versioni DocumentoVersione[]
  evidenze Evidence[]

  @@index([misuraId])
}

// Ogni fetch di un documento che risulta effettivamente cambiato (sha256
// diverso dall'ultima versione nota) crea una nuova riga qui — mai
// sovrascrivere (specifica, §19: "Non sovrascrivere la versione
// precedente"). testoEstratto è il testo già parsato (Postgres al posto
// dell'object storage S3 della specifica: stessa garanzia — mai
// riprocessare senza l'originale — senza bisogno di un bucket dedicato).
model DocumentoVersione {
  id             String             @id @default(cuid())
  documentoId    String
  documento      DocumentoUfficiale @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  sha256         String
  fetchedAt      DateTime           @default(now())
  pubblicatoIl   DateTime?
  rawSnapshotId  String?            @unique
  rawSnapshot    RawSnapshot?       @relation(fields: [rawSnapshotId], references: [id], onDelete: SetNull)
  testoEstratto  String?
  numeroPagine   Int?
  versioneParser String?

  evidenze Evidence[]

  @@index([documentoId, fetchedAt])
}

// Copia raw di OGNI fetch da una fonte (specifica, §14: "Mai elaborare una
// fonte senza conservarne una copia raw") — non solo dei documenti che
// diventano DocumentoVersione. In Postgres invece del pattern
// `raw/{source_id}/{yyyy}/{mm}/{dd}/{sha256}` su S3 della specifica: stesso
// scopo (audit, replay, regression test), storage diverso perché questo
// progetto non ha un bucket S3-compatibile.
model RawSnapshot {
  id          String   @id @default(cuid())
  fonteId     String
  fonte       Fonte    @relation(fields: [fonteId], references: [id], onDelete: Cascade)
  url         String
  fetchedAt   DateTime @default(now())
  statusCode  Int?
  contentType String?
  sha256      String
  corpo       String // contenuto raw (HTML/JSON/CSV testuale); i PDF vivono solo come DocumentoVersione.testoEstratto già parsato
  createdAt   DateTime @default(now())

  documentoVersione DocumentoVersione?

  @@index([fonteId, sha256])
  @@index([fonteId, fetchedAt])
}

enum StatoVerificaEvidence {
  SUPPORTATA
  PARZIALMENTE_SUPPORTATA
  NON_SUPPORTATA
  CONTRADDETTA
}

enum MetodoEstrazione {
  OPEN_DATA
  REGEX
  TABELLA
  LLM
  MANUALE
  DERIVATO
}

// Evidence per campo (specifica, §26 "Evidence-first extraction" — una
// delle regole più importanti della specifica): nessun campo può essere
// considerato verificato senza un riferimento a un documento ufficiale.
// `campo` è il nome del campo su Misura che questa evidence sostiene (es.
// "dataScadenza", "tettoMassimo", "atecoAmmessi").
model Evidence {
  id                  String                @id @default(cuid())
  misuraId            String
  misura              Misura                @relation(fields: [misuraId], references: [id], onDelete: Cascade)
  campo               String
  documentoId         String?
  documento           DocumentoUfficiale?   @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  documentoVersioneId String?
  documentoVersione   DocumentoVersione?    @relation(fields: [documentoVersioneId], references: [id], onDelete: SetNull)
  pagina              Int?
  sezione             String?
  estrattoTesto       String?
  confidence          Decimal               @db.Decimal(5, 4)
  statoVerifica       StatoVerificaEvidence
  metodoEstrazione    MetodoEstrazione
  createdAt           DateTime              @default(now())

  @@index([misuraId, campo])
}

enum TipoEventoBando {
  SCOPERTO
  DOCUMENTO_AGGIUNTO
  DOCUMENTO_CAMBIATO
  ESTRATTO
  VERIFICATO
  PUBBLICATO
  AGGIORNATO
  SCADENZA_PROROGATA
  APERTO
  CHIUSO
  SOSPESO
  FONDI_ESAURITI
  ANNULLATO
  RIAPERTO
  CONFLITTO_FONTI
  ERRORE_FONTE
  OVERRIDE_MANUALE
  /// La misura non è più comparsa nell'ultima scansione della fonte (specifica, §37) — mai un'eliminazione automatica, solo un segnale per il backoffice.
  ASSENTE_DA_FONTE
}

// Log eventi append-only (specifica, §33) — mai aggiornato/cancellato,
// solo aggiunto. Permette di mostrare in dashboard frasi come "Scadenza
// prorogata dal 30/09 al 31/10" invece di un update silenzioso del record.
model EventoBando {
  id        String          @id @default(cuid())
  misuraId  String
  misura    Misura          @relation(fields: [misuraId], references: [id], onDelete: Cascade)
  tipo      TipoEventoBando
  dettaglio Json?
  createdAt DateTime        @default(now())

  @@index([misuraId, createdAt])
}

// ---------------------------------------------------------------------------
// Prospect (anagrafiche importate, es. da export Atoka)
// ---------------------------------------------------------------------------
model Prospect {
  id               String   @id @default(cuid())
  ragioneSociale   String
  piva             String   @unique
  ateco            String?
  regione          String?
  provincia        String?
  fatturato        Decimal? @db.Decimal(14, 2)
  numeroDipendenti Int?
  email            String?
  telefono         String?
  fonteImport      String? // es. nome file CSV importato, o "OpenAPI IT-advanced"

  /// PEC — il contatto garantito dall'integrazione OpenAPI (email
  /// ordinaria/telefono/sito NON sono risultati garantiti da quella
  /// integrazione, vedi src/lib/prospecting). Distinta da `email`, che
  /// resta il contatto raccolto da CSV o dal form pubblico.
  pec String?

  /// Identificativo azienda lato OpenAPI (Search può restituire solo
  /// questo, senza P.IVA ancora nota) — chiave di riconciliazione verso
  /// la cache, indipendente dalla piva. @unique come richiesto dalla
  /// cache aziende (§8 delle specifiche): un ID provider non deve mai
  /// risultare associato a più di un'anagrafica interna.
  openApiId String? @unique

  /// Data dell'ultima chiamata Advanced riuscita per questa azienda — usata
  /// per decidere se i dati sono ancora entro la TTL di riutilizzo
  /// (OPENAPI_ADVANCED_TTL_GIORNI, default 90) prima di richiamare
  /// Advanced di nuovo. null = mai arricchita via Advanced (solo CSV/form
  /// pubblico, o solo Search senza arricchimento).
  datiAcquisitiAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches ProspectMisuraMatch[]

  @@index([regione])
  @@index([ateco])
}

// ---------------------------------------------------------------------------
// Prospecting automatico via OpenAPI (Search + Advanced) — sostituisce il
// caricamento manuale del CSV: dato un bando, cerca le aziende compatibili
// e arricchisce solo le candidate selezionate, riutilizzando i dati già in
// cache (vedi Prospect.datiAcquisitiAt/openApiId) tra bandi diversi.
// ---------------------------------------------------------------------------
enum TipoChiamataOpenApi {
  SEARCH
  ADVANCED
}

enum EsitoRicercaProspect {
  SUCCESSO
  ERRORE
  BUDGET_ESAURITO
  IN_CORSO
}

/// Contabilità di ogni chiamata a pagamento verso OpenAPI — usata per i
/// guardrail di budget (giornaliero/mensile/per bando) e per mostrare il
/// costo consuntivato, non solo quello stimato prima del run.
model ApiUsageLog {
  id           String              @id @default(cuid())
  tipo         TipoChiamataOpenApi
  unita        Int // record Search fatturabili, o 1 per ogni chiamata Advanced
  costoStimato Decimal             @db.Decimal(10, 4)
  misuraId     String?
  misura       Misura?             @relation(fields: [misuraId], references: [id], onDelete: SetNull)
  creatoAt     DateTime            @default(now())

  @@index([creatoAt])
  @@index([misuraId])
}

/// Un run del motore di prospecting per un bando — l'equivalente di ScanLog
/// per il monitoraggio fonti, ma per la ricerca aziende OpenAPI.
model RicercaProspectLog {
  id               String               @id @default(cuid())
  misuraId         String
  misura           Misura               @relation(fields: [misuraId], references: [id], onDelete: Cascade)
  avviataAt        DateTime             @default(now())
  completataAt     DateTime?
  esito            EsitoRicercaProspect
  candidateTrovate Int                  @default(0)
  aziendeNuove     Int                  @default(0) // arricchite via Advanced in questo run
  aziendeDaCache   Int                  @default(0) // dati riutilizzati, nessuna nuova chiamata Advanced
  matchTrovati     Int                  @default(0)
  costoStimato     Decimal              @default(0) @db.Decimal(10, 4)
  messaggioErrore  String?

  @@index([misuraId, avviataAt])
}

// Relazione calcolata dal motore di matching — ricreata ad ogni ricalcolo.
model ProspectMisuraMatch {
  id           String       @id @default(cuid())
  prospectId   String
  prospect     Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  misuraId     String
  misura       Misura       @relation(fields: [misuraId], references: [id], onDelete: Cascade)
  calcolatoAt  DateTime     @default(now())
  /// Elenco leggibile dei criteri soddisfatti (trasparenza sul perché del match)
  criteriEsito String[]     @default([])
  statoPratica StatoPratica @default(CANDIDATA)

  @@unique([prospectId, misuraId])
  @@index([misuraId])
  @@index([prospectId])
}
