    <script>
        // App State
        let appState = {
            currentProfile: 'work',
            tasks: [],
            diaryEntries: [],
            performance: {
                precision: 92,
                punctuality: 88,
                detail: 95
            },
            badges: [
                { id: 1, name: 'Prima Settimana Perfetta', icon: '🏆', unlocked: true },
                { id: 2, name: '10 Task in un Giorno', icon: '⚡', unlocked: true },
                { id: 3, name: '100% Precisione', icon: '🎯', unlocked: false },
                { id: 4, name: '30 Giorni di Diario', icon: '📝', unlocked: false },
                { id: 5, name: 'Mai in Ritardo', icon: '⏰', unlocked: true },
                { id: 6, name: 'Master dell\'Ordine', icon: '🌟', unlocked: false }
            ],
            currentMonth: new Date()
        };

        // Initialize app
        document.addEventListener('DOMContentLoaded', function() {
            initializeApp();
        });

        function initializeApp() {
            // Load saved data
            loadAppState();
            
            // Setup event listeners
            setupEventListeners();
            
            // Render initial content
            renderTasks();
            renderCalendar();
            updatePerformanceCharts();
            
            // Check time-based events
            checkTimeBasedEvents();
        }

        function setupEventListeners() {
            // Navigation tabs
            document.querySelectorAll('.nav-tab').forEach(tab => {
                tab.addEventListener('click', function() {
                    switchTab(this.dataset.section);
                });
            });

            // Profile selector
            document.querySelectorAll('.profile-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    switchProfile(this.dataset.profile);
                });
            });

            // Task form
            document.getElementById('taskForm').addEventListener('submit', function(e) {
                e.preventDefault();
                saveTask();
            });
        }

        function switchTab(section) {
            // Update tabs
            document.querySelectorAll('.nav-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelector(`[data-section="${section}"]`).classList.add('active');

            // Update content
            document.querySelectorAll('.content-section').forEach(content => {
                content.classList.remove('active');
            });
            document.getElementById(section).classList.add('active');
        }

        function switchProfile(profile) {
            appState.currentProfile = profile;
            
            // Update buttons
            document.querySelectorAll('.profile-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            document.querySelector(`[data-profile="${profile}"]`).classList.add('active');
            
            // Refresh content
            renderTasks();
            saveAppState();
        }

        // Task Management
        function openTaskModal() {
            document.getElementById('taskModal').classList.add('active');
            document.getElementById('taskDateTime').value = new Date().toISOString().slice(0, 16);
        }

        function closeTaskModal() {
            document.getElementById('taskModal').classList.remove('active');
            document.getElementById('taskForm').reset();
        }

        function saveTask() {
            const task = {
                id: Date.now(),
                title: document.getElementById('taskTitle').value,
                description: document.getElementById('taskDescription').value,
                category: document.getElementById('taskCategory').value,
                priority: document.getElementById('taskPriority').value,
                dateTime: document.getElementById('taskDateTime').value,
                completed: false,
                profile: appState.currentProfile,
                createdAt: new Date().toISOString()
            };

            appState.tasks.push(task);
            saveAppState();
            renderTasks();
            closeTaskModal();
            
            // Update performance
            updatePerformance('precision', 1);
        }

        function renderTasks() {
            const taskList = document.getElementById('taskList');
            const filteredTasks = appState.tasks.filter(task => 
                task.profile === appState.currentProfile && !task.completed
            );

            taskList.innerHTML = filteredTasks.map(task => `
                <div class="task-item" onclick="toggleTask(${task.id})">
                    <div class="task-checkbox ${task.completed ? 'checked' : ''}"></div>
                    <div class="task-content">
                        <div class="task-title">${task.title}</div>
                        <div class="task-meta">
                            <span class="task-priority priority-${task.priority}">${getPriorityLabel(task.priority)}</span>
                            <span>${formatDateTime(task.dateTime)}</span>
                            <span>${getCategoryLabel(task.category)}</span>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function toggleTask(taskId) {
            const task = appState.tasks.find(t => t.id === taskId);
            if (task) {
                task.completed = !task.completed;
                saveAppState();
                renderTasks();
                
                if (task.completed) {
                    updatePerformance('detail', 2);
                    checkAchievements();
                }
            }
        }

        // Calendar
        function renderCalendar() {
            const grid = document.getElementById('calendarGrid');
            const year = appState.currentMonth.getFullYear();
            const month = appState.currentMonth.getMonth();
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const today = new Date();

            // Update month header
            document.getElementById('currentMonth').textContent = 
                appState.currentMonth.toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });

            // Generate calendar days
            let html = '';
            
            // Empty cells before first day
            for (let i = 0; i < firstDay; i++) {
                html += '<div></div>';
            }
            
            // Days of month
            for (let day = 1; day <= daysInMonth; day++) {
                const isToday = today.getDate() === day && 
                               today.getMonth() === month && 
                               today.getFullYear() === year;
                html += `<div class="calendar-day ${isToday ? 'today' : ''}">${day}</div>`;
            }
            
            grid.innerHTML = html;

            // Render time blocks
            renderTimeBlocks();
        }

        function renderTimeBlocks() {
            const timeBlocks = document.getElementById('timeBlocks');
            const todayTasks = appState.tasks.filter(task => {
                const taskDate = new Date(task.dateTime);
                const today = new Date();
                return taskDate.toDateString() === today.toDateString() && 
                       task.profile === appState.currentProfile;
            });

            timeBlocks.innerHTML = todayTasks.map(task => `
                <div class="time-block" draggable="true" data-task-id="${task.id}">
                    <div>
                        <strong>${task.title}</strong>
                        <div style="font-size: 14px; color: var(--text-secondary);">
                            ${new Date(task.dateTime).toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' })}
                        </div>
                    </div>
                    <span class="task-priority priority-${task.priority}">${getPriorityLabel(task.priority)}</span>
                </div>
            `).join('');

            // Add drag and drop functionality
            setupDragAndDrop();
        }

        function previousMonth() {
            appState.currentMonth = new Date(appState.currentMonth.getFullYear(), appState.currentMonth.getMonth() - 1);
            renderCalendar();
        }

        function nextMonth() {
            appState.currentMonth = new Date(appState.currentMonth.getFullYear(), appState.currentMonth.getMonth() + 1);
            renderCalendar();
        }

        // Diary
        function saveDiary() {
            const entry = document.getElementById('diaryEntry').value;
            if (entry.trim()) {
                const diaryEntry = {
                    id: Date.now(),
                    content: entry,
                    date: new Date().toISOString(),
                    profile: appState.currentProfile
                };
                
                appState.diaryEntries.push(diaryEntry);
                saveAppState();
                
                // Clear textarea
                document.getElementById('diaryEntry').value = '';
                
                // Update performance
                updatePerformance('detail', 3);
                
                // Show success message
                showNotification('Diario salvato con successo!', 'success');
            }
        }

        // AI Assistant
        function sendAiMessage() {
            const input = document.getElementById('aiInput');
            const message = input.value.trim();
            
            if (message) {
                addChatMessage(message, 'user');
                input.value = '';
                
                // Simulate AI response
                setTimeout(() => {
                    const response = generateAiResponse(message);
                    addChatMessage(response, 'assistant');
                }, 1000);
            }
        }

        function handleAiInput(event) {
            if (event.key === 'Enter') {
                sendAiMessage();
            }
        }

        function usePrompt(prompt) {
            document.getElementById('aiInput').value = prompt;
            sendAiMessage();
        }

        function addChatMessage(message, sender) {
            const chat = document.getElementById('aiChat');
            const messageDiv = document.createElement('div');
            messageDiv.className = `ai-message ${sender}`;
            messageDiv.textContent = message;
            chat.appendChild(messageDiv);
            chat.scrollTop = chat.scrollHeight;
        }

        function generateAiResponse(message) {
            // Simple response generation based on keywords
            const responses = {
                'tempo': 'Analizzando i tuoi dati, noto che perdi più tempo nel pomeriggio tra le 14:00 e le 16:00. Ti suggerisco di pianificare task più impegnativi al mattino quando sei più produttivo.',
                'routine': 'Per migliorare la tua routine mattutina: 1) Svegliati sempre alla stessa ora, 2) Dedica 10 minuti alla pianificazione della giornata, 3) Inizia con il task più importante.',
                'pianificazione': 'Vedo che tendi a sottostimare il tempo necessario per completare i task. Prova ad aggiungere un buffer del 20% ad ogni stima temporale.',
                'ordinato': 'Ecco 3 azioni per domani: 1) Completa tutti i task entro l\'orario previsto, 2) Scrivi nel diario appena finisci di lavorare, 3) Prepara la lista dei task per dopodomani prima di dormire.'
            };

            for (const [keyword, response] of Object.entries(responses)) {
                if (message.toLowerCase().includes(keyword)) {
                    return response;
                }
            }

            return 'Interessante osservazione. Basandomi sui tuoi dati recenti, ti consiglio di concentrarti sul completamento dei task ad alta priorità prima di passare a quelli secondari. Vuoi che analizzi un aspetto specifico delle tue performance?';
        }

        // Performance
        function updatePerformance(metric, points) {
            if (appState.performance[metric] !== undefined) {
                appState.performance[metric] = Math.min(100, appState.performance[metric] + points);
                updatePerformanceCharts();
                saveAppState();
            }
        }

        function updatePerformanceCharts() {
            // Update scores
            document.querySelectorAll('.performance-score').forEach((el, index) => {
                const metrics = ['precision', 'punctuality', 'detail'];
                const value = appState.performance[metrics[index]];
                el.textContent = value + '%';
            });

            // Update progress rings
            document.querySelectorAll('.progress-ring-circle').forEach((circle, index) => {
                const metrics = ['precision', 'punctuality', 'detail'];
                const value = appState.performance[metrics[index]];
                const offset = 377 - (377 * value / 100);
                circle.style.strokeDashoffset = offset;
            });
        }

        // Utility functions
        function getPriorityLabel(priority) {
            const labels = {
                high: 'Alta',
                medium: 'Media',
                low: 'Bassa'
            };
            return labels[priority] || priority;
        }

        function getCategoryLabel(category) {
            const labels = {
                work: '💼 Lavoro',
                personal: '👤 Personale',
                family: '👨‍👩‍👧‍👦 Famiglia'
            };
            return labels[category] || category;
        }

        function formatDateTime(dateTime) {
            const date = new Date(dateTime);
            return date.toLocaleString('it-IT', {
                day: '2-digit',
                month: 'short',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function setupDragAndDrop() {
            const timeBlocks = document.querySelectorAll('.time-block');
            
            timeBlocks.forEach(block => {
                block.addEventListener('dragstart', (e) => {
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/html', e.target.innerHTML);
                    e.target.classList.add('dragging');
                });

                block.addEventListener('dragend', (e) => {
                    e.target.classList.remove('dragging');
                });

                block.addEventListener('dragover', (e) => {
                    if (e.preventDefault) {
                        e.preventDefault();
                    }
                    e.dataTransfer.dropEffect = 'move';
                    return false;
                });

                block.addEventListener('drop', (e) => {
                    if (e.stopPropagation) {
                        e.stopPropagation();
                    }
                    // Handle reordering logic here
                    return false;
                });
            });
        }

        function checkTimeBasedEvents() {
            const now = new Date();
            const hour = now.getHours();

            // Morning planning reminder
            if (hour === 8 && now.getMinutes() === 0) {
                showNotification('Buongiorno! È ora di pianificare la tua giornata.', 'info');
            }

            // Midday review
            if (hour === 12 && now.getMinutes() === 0) {
                showNotification('Pausa pranzo! Come sta andando la giornata?', 'info');
            }

            // Evening diary reminder
            if (hour === 20 && now.getMinutes() === 0) {
                showNotification('È ora di scrivere nel diario della giornata!', 'info');
            }
        }

        function checkAchievements() {
            // Check for new badges
            const completedToday = appState.tasks.filter(task => {
                const taskDate = new Date(task.dateTime);
                const today = new Date();
                return taskDate.toDateString() === today.toDateString() && task.completed;
            }).length;

            if (completedToday >= 10) {
                unlockBadge(2);
            }
        }

        function unlockBadge(badgeId) {
            const badge = appState.badges.find(b => b.id === badgeId);
            if (badge && !badge.unlocked) {
                badge.unlocked = true;
                saveAppState();
                showNotification(`Badge sbloccato: ${badge.name} ${badge.icon}`, 'success');
            }
        }

        function showNotification(message, type = 'info') {
            // Create notification element
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 15px 25px;
                background: ${type === 'success' ? 'var(--success)' : 'var(--primary-blue)'};
                color: white;
                border-radius: 10px;
                z-index: 3000;
                animation: slideIn 0.3s ease;
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        function addPhoto() {
            // Simulate photo upload
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*';
            input.onchange = (e) => {
                const file = e.target.files[0];
                if (file) {
                    showNotification('Foto aggiunta al diario!', 'success');
                }
            };
            input.click();
        }

        function addAudio() {
            // Simulate audio recording
            showNotification('Funzione di registrazione audio in arrivo!', 'info');
        }

        // State management functions (using in-memory storage instead of localStorage)
        function saveAppState() {
            // In sandbox environment, we just keep state in memory
            // In production, you would use localStorage:
            // localStorage.setItem('precisionAppState', JSON.stringify(appState));
            console.log('App state saved (in-memory)');
        }

        function loadAppState() {
            // In sandbox environment, we use default state
            // In production, you would load from localStorage:
            // const saved = localStorage.getItem('precisionAppState');
            // if (saved) {
            //     appState = { ...appState, ...JSON.parse(saved) };
            //     appState.currentMonth = new Date(appState.currentMonth);
            // }
            console.log('App state loaded (using defaults)');
        }

        // Check for time-based events every minute
        setInterval(checkTimeBasedEvents, 60000);
    </script>
</body>
</html>
